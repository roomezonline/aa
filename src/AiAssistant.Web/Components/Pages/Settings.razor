@page "/settings"
@using AiAssistant.Core.Interfaces
@inject IKnowledgeBase KnowledgeBase
@inject IEvolutionEngine EvolutionEngine

<div class="page-container" style="overflow-y:auto;">
    <div class="info-card">
        <h2 style="text-align:center; margin-bottom:20px; font-size:1.2rem;">تنظیمات</h2>
        <div class="stat-grid">
            <div class="stat-card">
                <div class="value">@_knowledgeCount</div>
                <div class="label">دانش ذخیره شده</div>
            </div>
            <div class="stat-card">
                <div class="value">@_queueCount</div>
                <div class="label">در نوبت یادگیری</div>
            </div>
            <div class="stat-card">
                <div class="value">@_dbSize</div>
                <div class="label">حجم دیتابیس</div>
            </div>
            <div class="stat-card">
                <div class="value">فعال</div>
                <div class="label">موتور تکامل</div>
            </div>
        </div>
    </div>
    <div class="info-card">
        <h3 style="margin-bottom:16px;">اطلاعات سیستم</h3>
        <ul class="info-list">
            <li>
                <span class="icon">&#128190;</span>
                <div>
                    <div class="primary">دیتابیس</div>
                    <div class="secondary">SQLite - AiAssistant.db</div>
                </div>
            </li>
            <li>
                <span class="icon">&#128187;</span>
                <div>
                    <div class="primary">نسخه</div>
                    <div class="secondary">1.0.0 - .NET 9</div>
                </div>
            </li>
            <li>
                <span class="icon">&#129302;</span>
                <div>
                    <div class="primary">موتور تکامل</div>
                    <div class="secondary">یادگیری خودکار از چت و اینترنت</div>
                </div>
            </li>
        </ul>
    </div>
</div>

@code {
    private int _knowledgeCount;
    private int _queueCount;
    private string _dbSize = "...";

    protected override async Task OnInitializedAsync()
    {
        try { _knowledgeCount = await KnowledgeBase.GetTotalCountAsync(); _queueCount = await EvolutionEngine.GetQueueCountAsync(); } catch { }
        try { var fi = new System.IO.FileInfo("AiAssistant.db"); _dbSize = fi.Exists ? (fi.Length > 1048576 ? $"{fi.Length / 1048576.0:F1} MB" : $"{fi.Length / 1024.0:F1} KB") : "0 KB"; }
        catch { _dbSize = "نامشخص"; }
    }
}