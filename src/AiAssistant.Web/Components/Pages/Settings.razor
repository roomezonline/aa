@page "/settings"

@using AiAssistant.Core.Configuration
@using AiAssistant.Core.Interfaces
@inject IKnowledgeBase KnowledgeBase

<MudContainer MaxWidth="MaxWidth.False" Class="mt-4">
    <MudPaper Elevation="2" Class="pa-6">
        <MudText Typo="Typo.h5" Class="mb-4" Align="Align.Center">
            تنظیمات
        </MudText>

        <MudGrid>
            <MudItem xs="12">
                <MudText Typo="Typo.h6" Class="mb-2">آمار سیستم</MudText>
            </MudItem>
            
            <MudItem xs="6">
                <MudCard>
                    <MudCardContent>
                        <MudText Typo="Typo.h4" Align="Align.Center" Color="Color.Primary">
                            @_knowledgeCount
                        </MudText>
                        <MudText Typo="Typo.body2" Align="Align.Center">
                            تعداد دانش ذخیره شده
                        </MudText>
                    </MudCardContent>
                </MudCard>
            </MudItem>

            <MudItem xs="6">
                <MudCard>
                    <MudCardContent>
                        <MudText Typo="Typo.h4" Align="Align.Center" Color="Color.Secondary">
                            @_dbSize
                        </MudText>
                        <MudText Typo="Typo.body2" Align="Align.Center">
                            حجم دیتابیس
                        </MudText>
                    </MudCardContent>
                </MudCard>
            </MudItem>
        </MudGrid>

        <MudDivider Class="my-4" />

        <MudText Typo="Typo.h6" Class="mb-2">اطلاعات اتصال</MudText>
        
        <MudList T="string">
            <MudListItem T="string">
                <MudListItemIcon Icon="@Icons.Material.Filled.Memory" />
                <MudListItemText Primary="Ollama Server" 
                                 Secondary="http://localhost:11434" />
            </MudListItem>
            <MudListItem T="string">
                <MudListItemIcon Icon="@Icons.Material.Filled.Storage" />
                <MudListItemText Primary="دیتابیس" 
                                 Secondary="SQLite - AiAssistant.db" />
            </MudListItem>
            <MudListItem T="string">
                <MudListItemIcon Icon="@Icons.Material.Filled.Code" />
                <MudListItemText Primary="نسخه" 
                                 Secondary="1.0.0 - .NET 9" />
            </MudListItem>
        </MudList>

        <MudDivider Class="my-4" />

        <MudText Typo="Typo.h6" Class="mb-2">راهنما</MudText>
        <MudText Typo="Typo.body2" Class="mb-2">
            ۱. Ollama را نصب کنید: https://ollama.com
        </MudText>
        <MudText Typo="Typo.body2" Class="mb-2">
            ۲. مدل را دانلود کنید: ollama pull llama3.2
        </MudText>
        <MudText Typo="Typo.body2" Class="mb-2">
            ۳. سرور Ollama را اجرا کنید: ollama serve
        </MudText>
    </MudPaper>
</MudContainer>

@code {
    private int _knowledgeCount;
    private string _dbSize = "...";

    protected override async Task OnInitializedAsync()
    {
        _knowledgeCount = await KnowledgeBase.GetTotalCountAsync();
        
        try
        {
            var fileInfo = new System.IO.FileInfo("AiAssistant.db");
            if (fileInfo.Exists)
            {
                _dbSize = fileInfo.Length > 1024 * 1024
                    ? $"{fileInfo.Length / (1024.0 * 1024.0):F1} MB"
                    : $"{fileInfo.Length / 1024.0:F1} KB";
            }
            else
            {
                _dbSize = "0 KB";
            }
        }
        catch
        {
            _dbSize = "نامشخص";
        }
    }
}
