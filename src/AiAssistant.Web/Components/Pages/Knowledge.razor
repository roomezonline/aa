@page "/knowledge"
@using AiAssistant.Core.Interfaces
@using AiAssistant.Core.Models
@inject IKnowledgeBase KnowledgeBase
@inject IEmbeddingService EmbeddingService

<div class="page-container" style="overflow-y:auto;">
    <div class="info-card">
        <h2 style="text-align:center; margin-bottom:16px; font-size:1.2rem;">پایگاه دانش</h2>
        <div class="input-wrapper" style="margin-bottom:16px;">
            <input class="form-input" style="border:none;" @bind="_searchQuery"
                   placeholder="جستجو..." @onkeydown="HandleKeyDown" />
            <button class="send-btn" @onclick="SearchAsync">&#128269;</button>
        </div>
        @if (_isLoading)
        {
            <div class="progress-bar"><div class="progress-bar-fill" style="width:100%;"></div></div>
        }
    </div>

    @if (_results.Any())
    {
        <p style="color:var(--text-secondary); font-size:0.9rem; margin-bottom:12px;">@_results.Count نتیجه</p>
        @foreach (var item in _results)
        {
            <div class="knowledge-card">
                <h3>@item.Question</h3>
                <p>@item.Answer</p>
                <span class="chip chip-primary">@item.Source</span>
            </div>
        }
    }
    else if (!string.IsNullOrWhiteSpace(_searchQuery) && !_isLoading)
    {
        <div class="info-card" style="text-align:center; color:var(--text-secondary);">نتیجه‌ای یافت نشد</div>
    }
</div>

@code {
    private string _searchQuery = "";
    private bool _isLoading;
    private List<KnowledgeEntry> _results = new();

    private async Task SearchAsync()
    {
        if (string.IsNullOrWhiteSpace(_searchQuery)) return;
        _isLoading = true; StateHasChanged();
        try { var embedding = await EmbeddingService.GetEmbeddingAsync(_searchQuery); _results = await KnowledgeBase.SearchAsync(_searchQuery, embedding, 20); }
        catch { _results.Clear(); }
        finally { _isLoading = false; StateHasChanged(); }
    }

    private async Task HandleKeyDown(KeyboardEventArgs e) { if (e.Key == "Enter") await SearchAsync(); }
}