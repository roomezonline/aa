@page "/knowledge"
@using AiAssistant.Core.Interfaces
@using AiAssistant.Core.Models
@inject IKnowledgeBase KnowledgeBase
@inject IEmbeddingService EmbeddingService

<MudContainer MaxWidth="MaxWidth.False" Class="mt-4">
    <MudPaper Elevation="2" Class="pa-6">
        <MudText Typo="Typo.h5" Class="mb-4" Align="Align.Center">
            پایگاه دانش
        </MudText>

        <MudTextField @bind-Value="_searchQuery"
                      Label="جستجو در دانش"
                      Placeholder="کلمه کلیدی را وارد کنید..."
                      Variant="Variant.Outlined"
                      Adornment="Adornment.End"
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      OnAdornmentClick="SearchKnowledgeAsync"
                      OnKeyDown="HandleSearchKeyDown"
                      Class="mb-4"
                      Style="direction: rtl;" />

        @if (_isLoading)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
        }

        @if (_results.Any())
        {
            <MudText Typo="Typo.body2" Class="mb-2">
                @_results.Count نتیجه یافت شد
            </MudText>

            @foreach (var item in _results)
            {
                <MudCard Class="mb-3">
                    <MudCardContent>
                        <MudText Typo="Typo.subtitle1" Color="Color.Primary">
                            @item.Question
                        </MudText>
                        <MudText Typo="Typo.body2" Class="mt-2">
                            @item.Answer
                        </MudText>
                        <MudChip T="string" Size="Size.Small" Color="Color.Secondary" Class="mt-2">
                            @item.Source
                        </MudChip>
                    </MudCardContent>
                </MudCard>
            }
        }
        else if (!string.IsNullOrWhiteSpace(_searchQuery) && !_isLoading)
        {
            <MudText Typo="Typo.body1" Align="Align.Center" Class="mt-4">
                نتیجه‌ای یافت نشد
            </MudText>
        }
    </MudPaper>
</MudContainer>

@code {
    private string _searchQuery = string.Empty;
    private bool _isLoading;
    private List<KnowledgeEntry> _results = new();

    private async Task SearchKnowledgeAsync()
    {
        if (string.IsNullOrWhiteSpace(_searchQuery)) return;

        _isLoading = true;
        StateHasChanged();

        try
        {
            var embedding = await EmbeddingService.GetEmbeddingAsync(_searchQuery);
            _results = await KnowledgeBase.SearchAsync(_searchQuery, embedding, 20);
        }
        catch
        {
            _results.Clear();
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private async Task HandleSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await SearchKnowledgeAsync();
        }
    }
}
