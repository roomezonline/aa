@page "/learn"
@using AiAssistant.Core.Interfaces
@using AiAssistant.Core.Models
@inject ISelfLearner SelfLearner
@inject IEvolutionEngine EvolutionEngine

<div class="page-container" style="overflow-y:auto;">
    <div class="info-card">
        <h2 style="text-align:center; margin-bottom:16px; font-size:1.2rem;">یادگیری خودکار</h2>
        <p style="text-align:center; color:var(--text-secondary); margin-bottom:24px;">
            موضوع مورد نظر را وارد کنید تا دستیار درباره آن تحقیق کند.
        </p>
        <div class="form-group">
            <label class="form-label">موضوع تحقیق</label>
            <input class="form-input" @bind="_topic" placeholder="مثلاً: هوش مصنوعی، برنامه‌نویسی..." />
        </div>
        <div class="form-group">
            <label class="form-label">مدت زمان</label>
            <select class="form-select" @bind="_durationMinutes">
                <option value="5">۵ دقیقه</option>
                <option value="15">۱۵ دقیقه</option>
                <option value="30">۳۰ دقیقه</option>
            </select>
        </div>
        @if (!_isLearning)
        {
            <button class="btn btn-primary" @onclick="StartLearningAsync">شروع تحقیق</button>
        }
        else
        {
            <div class="progress-bar"><div class="progress-bar-fill" style="width: 100%; animation: pulse 1.5s infinite;"></div></div>
            <button class="btn btn-danger" @onclick="StopLearningAsync">توقف</button>
        }
    </div>

    <div class="info-card">
        <h3 style="margin-bottom:12px;">نوبت یادگیری خودکار</h3>
        <div style="display:flex; gap:8px; align-items:center; margin-bottom:16px;">
            <span class="chip chip-primary">@_queueCount موضوع در انتظار</span>
            @if (_queueCount > 0)
            {
                <button class="btn btn-primary" style="width:auto; padding:8px 16px; font-size:0.85rem;"
                        @onclick="StartAutoLearningAsync">یادگیری خودکار</button>
            }
        </div>
        @if (_pendingItems.Any())
        {
            <div class="log-container">
                @foreach (var item in _pendingItems.Take(10))
                {
                    <div class="log-item">
                        <span style="color:var(--primary);">?</span>
                        <span>@item.Question</span>
                        <span class="chip chip-secondary" style="margin-right:auto; font-size:0.7rem;">اولویت @item.Priority</span>
                    </div>
                }
            </div>
        }
        else
        {
            <p style="color:var(--text-secondary); text-align:center; padding:16px;">
                نوبت یادگیری خالی است. هر سوالی بپرسید، دستیار خودش یاد می‌گیرد.
            </p>
        }
    </div>

    @if (_logs.Any())
    {
        <div class="info-card">
            <h3 style="margin-bottom:12px;">گزارش:</h3>
            <div class="log-container">
                @foreach (var log in _logs)
                {
                    <div class="log-item">
                        <span class="check">&#10003;</span>
                        <span>@log</span>
                    </div>
                }
            </div>
        </div>
    }
</div>

@code {
    private string _topic = "";
    private int _durationMinutes = 5;
    private bool _isLearning;
    private int _queueCount;
    private List<LearningQueueItem> _pendingItems = new();
    private List<string> _logs = new();
    private CancellationTokenSource? _cts;

    protected override async Task OnInitializedAsync() { await RefreshQueueAsync(); }

    private async Task RefreshQueueAsync()
    {
        try { _queueCount = await EvolutionEngine.GetQueueCountAsync(); _pendingItems = await EvolutionEngine.GetPendingQueueAsync(); } catch { }
        StateHasChanged();
    }

    private async Task StartLearningAsync()
    {
        if (string.IsNullOrWhiteSpace(_topic)) return;
        _isLearning = true; _logs.Clear(); _cts = new CancellationTokenSource();
        var progress = new Progress<string>(log => { _logs.Add(log); InvokeAsync(StateHasChanged); });
        try { await SelfLearner.StartLearningAsync(_topic, TimeSpan.FromMinutes(_durationMinutes), progress, _cts.Token); }
        catch (Exception ex) { _logs.Add("خطا: " + ex.Message); }
        finally { _isLearning = false; await RefreshQueueAsync(); }
    }

    private async Task StartAutoLearningAsync()
    {
        _isLearning = true; _logs.Add("شروع یادگیری خودکار..."); StateHasChanged();
        _cts = new CancellationTokenSource();
        try { await EvolutionEngine.StartEvolutionAsync(_cts.Token); }
        catch (OperationCanceledException) { }
        catch (Exception ex) { _logs.Add("خطا: " + ex.Message); }
        finally { _isLearning = false; await RefreshQueueAsync(); }
    }

    private void StopLearningAsync() => _cts?.Cancel();
}