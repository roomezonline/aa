@page "/learn"
@using AiAssistant.Core.Interfaces
@inject ISelfLearner SelfLearner

<MudContainer MaxWidth="MaxWidth.False" Class="mt-4">
    <MudPaper Elevation="2" Class="pa-6">
        <MudText Typo="Typo.h5" Class="mb-4" Align="Align.Center">
            یادگیری خودکار
        </MudText>

        <MudText Typo="Typo.body1" Class="mb-4" Align="Align.Center">
            موضوع مورد نظر را وارد کنید تا دستیار هوشمند به صورت خودکار درباره آن تحقیق کند.
        </MudText>

        <MudTextField @bind-Value="_topic"
                      Label="موضوع تحقیق"
                      Placeholder="مثلاً: هوش مصنوعی، برنامه‌نویسی..."
                      Variant="Variant.Outlined"
                      Class="mb-4"
                      Style="direction: rtl;" />

        <MudSelect T="int" @bind-Value="_durationMinutes"
                   Label="مدت زمان تحقیق"
                   Variant="Variant.Outlined"
                   Class="mb-4">
            <MudSelectItem Value="5">۵ دقیقه</MudSelectItem>
            <MudSelectItem Value="15">۱۵ دقیقه</MudSelectItem>
            <MudSelectItem Value="30">۳۰ دقیقه</MudSelectItem>
            <MudSelectItem Value="60">۱ ساعت</MudSelectItem>
        </MudSelect>

        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   FullWidth="true"
                   OnClick="StartLearningAsync"
                   Disabled="@_isLearning"
                   Size="Size.Large">
            @if (_isLearning)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="me-2" />
                <span>در حال تحقیق...</span>
            }
            else
            {
                <span>شروع تحقیق</span>
            }
        </MudButton>

        @if (_isLearning)
        {
            <MudButton Variant="Variant.Outlined"
                       Color="Color.Error"
                       FullWidth="true"
                       OnClick="StopLearningAsync"
                       Class="mt-2">
                توقف
            </MudButton>
        }

        @if (_logs.Any())
        {
            <MudDivider Class="my-4" />
            <MudText Typo="Typo.h6" Class="mb-2">گزارش تحقیق:</MudText>
            <MudPaper Class="pa-3" Style="max-height: 300px; overflow-y: auto; direction: rtl;">
                @foreach (var log in _logs)
                {
                    <MudText Typo="Typo.body2" Class="mb-1">
                        <MudIcon Icon="@Icons.Material.Filled.CheckCircle"
                                 Color="Color.Success" Size="Size.Small" />
                        @log
                    </MudText>
                }
            </MudPaper>
        }
    </MudPaper>
</MudContainer>

@code {
    private string _topic = string.Empty;
    private int _durationMinutes = 5;
    private bool _isLearning;
    private List<string> _logs = new();
    private CancellationTokenSource? _cts;

    private async Task StartLearningAsync()
    {
        if (string.IsNullOrWhiteSpace(_topic)) return;

        _isLearning = true;
        _logs.Clear();
        _cts = new CancellationTokenSource();

        var progress = new Progress<string>(log =>
        {
            _logs.Add(log);
            InvokeAsync(StateHasChanged);
        });

        try
        {
            await SelfLearner.StartLearningAsync(
                _topic,
                TimeSpan.FromMinutes(_durationMinutes),
                progress,
                _cts.Token);
        }
        catch (Exception ex)
        {
            _logs.Add("خطا: " + ex.Message);
        }
        finally
        {
            _isLearning = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void StopLearningAsync()
    {
        _cts?.Cancel();
    }
}
