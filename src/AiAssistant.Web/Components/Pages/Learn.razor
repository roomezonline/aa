@page "/learn"
@using AiAssistant.Core.Interfaces
@inject ISelfLearner SelfLearner

<div class="page-container" style="overflow-y:auto;">
    <div class="info-card">
        <h2 style="text-align:center; margin-bottom:16px; font-size:1.2rem;">&#127891; یادگیری خودکار</h2>
        <p style="text-align:center; color:var(--text-secondary); margin-bottom:24px;">
            موضوع مورد نظر را وارد کنید تا دستیار درباره آن تحقیق کند.
        </p>

        <div class="form-group">
            <label class="form-label">موضوع تحقیق</label>
            <input class="form-input" @bind="_topic" placeholder="مثلاً: هوش مصنوعی، برنامه‌نویسی..." />
        </div>

        <div class="form-group">
            <label class="form-label">مدت زمان</label>
            <select class="form-select" @bind="_durationMinutes">
                <option value="5">۵ دقیقه</option>
                <option value="15">۱۵ دقیقه</option>
                <option value="30">۳۰ دقیقه</option>
                <option value="60">۱ ساعت</option>
            </select>
        </div>

        @if (!_isLearning)
        {
            <button class="btn btn-primary" @onclick="StartLearningAsync">
                شروع تحقیق
            </button>
        }
        else
        {
            <div class="progress-bar">
                <div class="progress-bar-fill" style="width: 100%; animation: pulse 1.5s infinite;"></div>
            </div>
            <button class="btn btn-danger" @onclick="StopLearningAsync">
                توقف
            </button>
        }
    </div>

    @if (_logs.Any())
    {
        <div class="info-card">
            <h3 style="margin-bottom:12px;">گزارش:</h3>
            <div class="log-container">
                @foreach (var log in _logs)
                {
                    <div class="log-item">
                        <span class="check">&#10003;</span>
                        <span>@log</span>
                    </div>
                }
            </div>
        </div>
    }
</div>

@code {
    private string _topic = "";
    private int _durationMinutes = 5;
    private bool _isLearning;
    private List<string> _logs = new();
    private CancellationTokenSource? _cts;

    private async Task StartLearningAsync()
    {
        if (string.IsNullOrWhiteSpace(_topic)) return;
        _isLearning = true;
        _logs.Clear();
        _cts = new CancellationTokenSource();

        var progress = new Progress<string>(log =>
        {
            _logs.Add(log);
            InvokeAsync(StateHasChanged);
        });

        try
        {
            await SelfLearner.StartLearningAsync(_topic, TimeSpan.FromMinutes(_durationMinutes), progress, _cts.Token);
        }
        catch (Exception ex) { _logs.Add("خطا: " + ex.Message); }
        finally { _isLearning = false; await InvokeAsync(StateHasChanged); }
    }

    private void StopLearningAsync() => _cts?.Cancel();
}
