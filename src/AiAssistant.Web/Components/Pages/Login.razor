@page "/login"
@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@inject NavigationManager Nav

<div class="login-page">
    <div class="login-card">
        <div class="login-logo">&#129302;</div>
        <h1 class="login-title">دستیار هوش مصنوعی</h1>
        <p class="login-subtitle">برای شروع وارد شوید</p>

        <div class="login-buttons">
            <a href="/auth/google" class="login-btn google-btn">
                <svg width="20" height="20" viewBox="0 0 48 48">
                    <path fill="#FFC107" d="M43.6 20.1H42V20H24v8h11.3C33.8 33.6 29.3 36 24 36c-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.8 1.2 8 3l5.7-5.7C34 5.7 29.3 4 24 4 12.9 4 4 12.9 4 24s8.9 20 20 20 20-8.9 20-20c0-1.3-.2-2.7-.4-3.9z"/>
                    <path fill="#FF3D00" d="M6.3 14.7l6.6 4.8C14.5 15.5 18.9 12 24 12c3.1 0 5.8 1.2 8 3l5.7-5.7C34 5.7 29.3 4 24 4 16.3 4 9.7 8.3 6.3 14.7z"/>
                    <path fill="#4CAF50" d="M24 44c5.2 0 9.9-1.8 13.4-4.7l-6.2-5.2C29.2 35.9 26.7 36 24 36c-5.2 0-9.6-3.3-11.2-8l-6.5 5C9.5 39.6 16.2 44 24 44z"/>
                    <path fill="#1976D2" d="M43.6 20.1H42V20H24v8h11.3c-.8 2.2-2.2 4.1-4.1 5.5l6.2 5.2C36.7 39.5 44 34 44 24c0-1.3-.2-2.7-.4-3.9z"/>
                </svg>
                <span>ورود با گوگل</span>
            </a>

            <a href="/auth/guest" class="login-btn guest-btn">
                <span>&#128100;</span>
                <span>ورود به عنوان مهمان</span>
            </a>
        </div>

        <p class="login-footer">با ورود، شما <a href="#">شرایط استفاده</a> را می‌پذیرید.</p>
    </div>
</div>

@code {
    protected override void OnInitialized()
    {
        if (SignInManager.IsSignedIn(SignInManager.Context.User))
        {
            Nav.NavigateTo("/", true);
        }
    }
}
