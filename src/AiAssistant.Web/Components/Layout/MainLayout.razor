@inherits LayoutComponentBase
@inject NavigationManager NavManager

<div class="app-layout">
    <div class="app-bar">
        <button class="app-bar-icon" @onclick="ToggleSidebar">&#9776;</button>
        <h1>دستیار هوش مصنوعی</h1>
    </div>

    <div class="sidebar-overlay @(SidebarOpen ? "open" : "")" @onclick="CloseSidebar"></div>
    <nav class="sidebar @(SidebarOpen ? "open" : "")">
        <div class="sidebar-header">
            <h2>منو</h2>
        </div>
        <div class="sidebar-nav">
            <a class="nav-item @(IsActive("/"))" href="/" @onclick="CloseSidebar">
                <span class="icon">&#128172;</span>
                <span>چت</span>
            </a>
            <a class="nav-item @(IsActive("/learn"))" href="/learn" @onclick="CloseSidebar">
                <span class="icon">&#127891;</span>
                <span>یادگیری خودکار</span>
            </a>
            <a class="nav-item @(IsActive("/knowledge"))" href="/knowledge" @onclick="CloseSidebar">
                <span class="icon">&#128218;</span>
                <span>پایگاه دانش</span>
            </a>
            <a class="nav-item @(IsActive("/settings"))" href="/settings" @onclick="CloseSidebar">
                <span class="icon">&#9881;</span>
                <span>تنظیمات</span>
            </a>
        </div>
    </nav>

    <div class="main-content">
        @Body
    </div>
</div>

@code {
    private bool SidebarOpen = false;

    private void ToggleSidebar() => SidebarOpen = !SidebarOpen;
    private void CloseSidebar() => SidebarOpen = false;

    private string IsActive(string path)
    {
        var uri = NavManager.Uri;
        var baseUri = NavManager.BaseUri.TrimEnd('/');
        if (path == "/")
            return uri.TrimEnd('/') == baseUri ? "active" : "";
        return uri.Contains(path) ? "active" : "";
    }
}
