{
  "AiSettings": {
    "OllamaBaseUrl": "http://localhost:11434",
    "DefaultModel": "llama3.2",
    "EmbeddingModel": "nomic-embed-text",
    "MaxContextMessages": 20,
    "SimilarityThreshold": 0.85,
    "DatabasePath": "AiAssistant.db",
    "SystemPrompt": "تو یک دستیار هوشمند فارسی هستی. پاسخ‌های دقیق، روان و مفید بده. اگر جواب را نمی‌دانی، صادقانه بگو."
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
